Redirect 301 "/shared/document/Для сайта подписанная с С на В.pdf" /docs/rabochaya-programma-c-na-b.pdf
Redirect 301 "/shared/document/пункт №4Реализуемые_образовательные_программы.pdf" /docs/realizuemye-programmy-v2.pdf
Redirect 301 "/shared/document/Программа для сайта до 18 лет подписанная.pdf" /docs/rabochaya-programma-kat-b-do-18.pdf
Redirect 301 "/shared/document/С АКПП на МКПП подписанная для сайта.pdf" /docs/rabochaya-programma-akpp-na-mkpp.pdf
Redirect 301 "/shared/document/ОВЗ подписанная для сайта.pdf" /docs/rabochaya-programma-kat-b-ovz.pdf
Redirect 301 "/shared/document/пункт №4 Рабочий учебный план категории В.pdf" /docs/uchebnyy-plan-kat-b.pdf
Redirect 301 "/shared/document/пункт №4рабочий учебный план с С на В.pdf" /docs/uchebnyy-plan-c-na-b.pdf
Redirect 301 "/shared/document/пункт №4рабочий учебный план для 18 лет.pdf" /docs/uchebnyy-plan-kat-b-do-18.pdf
Redirect 301 "/shared/document/пункт №4календарный учебный график кат В.pdf" /docs/kalendarnyy-grafik-kat-b.pdf
Redirect 301 "/shared/document/пункт №4календарный учебный график с С на В.pdf" /docs/kalendarnyy-grafik-c-na-b.pdf
Redirect 301 "/shared/document/пункт №4календарный учебный график для 18 лет.pdf" /docs/kalendarnyy-grafik-kat-b-do-18.pdf
