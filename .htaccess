# Сгенерировано scripts/make-htaccess.mjs — правки вносить в скрипт.
AddDefaultCharset utf-8
Options -Indexes
ErrorDocument 404 /404.html

RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://avto-status27.ru%{REQUEST_URI} [L,R=301]

# Старый сайт: разделы «Сведений» и страницы
RewriteRule ^Articles/Common/?$ /sveden/ [NC,L,R=301]
RewriteRule ^Home/About/?$ / [NC,L,R=301]
RewriteRule ^Identity/ / [NC,L,R=301]
RewriteRule ^Articles/Details/1/?$ /sveden/common/ [NC,L,R=301]
RewriteRule ^Articles/Details/2/?$ /sveden/struct/ [NC,L,R=301]
RewriteRule ^Articles/Details/3/?$ /sveden/document/ [NC,L,R=301]
RewriteRule ^Articles/Details/4/?$ /sveden/education/ [NC,L,R=301]
RewriteRule ^Articles/Details/5/?$ /sveden/employees/ [NC,L,R=301]
RewriteRule ^Articles/Details/6/?$ /sveden/objects/ [NC,L,R=301]
RewriteRule ^Articles/Details/7/?$ /sveden/grants/ [NC,L,R=301]
RewriteRule ^Articles/Details/8/?$ /sveden/catering/ [NC,L,R=301]
RewriteRule ^Articles/Details/9/?$ /sveden/paid_edu/ [NC,L,R=301]
RewriteRule ^Articles/Details/10/?$ /sveden/budget/ [NC,L,R=301]
RewriteRule ^Articles/Details/11/?$ /sveden/vacant/ [NC,L,R=301]
RewriteRule ^Articles/Details/12/?$ /sveden/objects/ [NC,L,R=301]
RewriteRule ^Articles/Details/13/?$ /sveden/inter/ [NC,L,R=301]
RewriteRule ^Articles/Details/14/?$ /sveden/objects/ [NC,L,R=301]
RewriteRule ^Articles/Details/15/?$ /sveden/objects/ [NC,L,R=301]

# Старый сайт: документы /shared/document/<имя>.pdf → /docs/<новое имя>
Redirect 301 "/shared/document/Положение ПЕДСОВЕТ.pdf" /docs/polozhenie-o-pedsovete.pdf
Redirect 301 "/shared/document/УСТАВ школа.pdf" /docs/ustav.pdf
Redirect 301 "/shared/document/СВИДЕТЕЛЬСТВО о регистрации.pdf" /docs/svidetelstvo-o-registracii.pdf
Redirect 301 "/shared/document/ПРАВИЛА ВНУТРЕННЕГО РАСПОРЯДКА ДЛЯ ОБУЧАЮЩИХСЯ.pdf" /docs/pravila-vnutrennego-rasporyadka-obuchayushchihsya.pdf
Redirect 301 "/shared/document/ПРАВИЛА ВНУТРЕННЕГО ТРУДОВОГО РАСПОРЯДКА.pdf" /docs/pravila-vnutrennego-trudovogo-rasporyadka.pdf
Redirect 301 "/shared/document/для пункта №3 Отчет самообследование 2024.pdf" /docs/otchet-samoobsledovanie-2024.pdf
Redirect 301 "/shared/document/Отчет о самообследовании 2025 год.pdf" /docs/otchet-samoobsledovanie-2025.pdf
Redirect 301 "/shared/document/для пункта №3 ПОЛОЖЕНИЕ О ПРАВИЛАХ ПРИЕМА, ПЕРЕВОДА, ОТЧИСЛЕНИЯ, и ВОССТАНОВЛЕНИЯ ОБУЧАЮЩЕГОСЯ.pdf" /docs/polozhenie-priem-perevod-otchislenie.pdf
Redirect 301 "/shared/document/для пункта №3 положение о промежуточной и итоговой аттестации.pdf" /docs/polozhenie-attestaciya.pdf
Redirect 301 "/shared/document/для пункта №3 РЕЖИМ ЗАНЯТИЙ.jpg" /docs/rezhim-zanyatiy.jpg
