Redirect 301 "/shared/document/пункт №5Руководящий состав, преподаватели.pdf" /docs/pedagogicheskiy-sostav.pdf
Redirect 301 "/shared/document/пункт №6МАТ-ТЕХ ОБЕСПЕЧЕНИЕ.pdf" /sveden/objects/
Redirect 301 "/shared/document/для пункта № 2ПОЛОЖЕНИЕ о стипендии.pdf" /docs/polozhenie-o-merah-podderzhki.pdf
Redirect 301 "/shared/document/Положение о платных услугах.pdf" /docs/polozhenie-o-platnyh-uslugah.pdf
Redirect 301 "/shared/document/Прейскурант .pdf" /docs/preyskurant-2026-03-01.pdf
Redirect 301 "/shared/document/образец ДОГОВОР С ОБУЧАЮЩИМИСЯ.pdf" /docs/dogovor-obrazec.pdf
Redirect 301 "/shared/document/образец Договор несовершеннолетних.pdf" /docs/dogovor-obrazec-nesovershennoletnie.pdf
Redirect 301 "/shared/document/пункт № 10 План финансово-хозяйственной деятельности на 2024 год.pdf" /docs/plan-fhd-2024.pdf
Redirect 301 "/shared/document/пункт №12Доступная среда для людей с ОВЗ и инвалидов.pdf" /docs/dostupnaya-sreda.pdf
Redirect 301 "/shared/document/Заключение Роспотребнадзора.pdf" /docs/zaklyuchenie-rospotrebnadzora.pdf
Redirect 301 "/shared/document/Заключение Роспотребнадзор Полярная,57.pdf" /docs/zaklyuchenie-rospotrebnadzora-polyarnaya-57.pdf
Redirect 301 "/shared/document/Заключение специалиста по ПБ.pdf" /docs/zaklyuchenie-pozharnaya-bezopasnost.pdf
RedirectMatch 301 ^/shared/document/ /sveden/document/

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
