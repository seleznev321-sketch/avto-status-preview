Redirect 301 "/shared/document/пункт № 3 Предостережение_ЧОУ ДПО ШВ Авто-Статус.pdf" /docs/predosterezhenie-minobr-2024-339.pdf
Redirect 301 "/shared/document/для пункта №4 ПОЛОЖЕНИЕ О ЯЗЫКАХ ОБРАЗОВАНИЯ.pdf" /docs/polozhenie-o-yazykah-obrazovaniya.pdf
